<!-- DownloadQueueControl — Dense-row download queue (prototype A). -->

<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Phlegethon.Controls">

    <!-- Default download-item template -->
    <DataTemplate x:Key="DownloadItemTemplate" x:DataType="controls:DownloadItemViewModel">
        <Border
            Background="Transparent"
            BorderBrush="{ThemeResource GeistBorderBrush}"
            BorderThickness="0,0,0,1"
            Height="{ThemeResource GeistRowHeight}"
            Padding="0,0,12,0">
            <Grid
                ColumnSpacing="8"
                Padding="12,0,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Status icon -->
                <Border
                    Grid.Column="0"
                    Width="24"
                    Height="24"
                    CornerRadius="4"
                    Background="{ThemeResource GeistGray100}"
                    VerticalAlignment="Center">
                    <TextBlock
                        Text="{Binding StatusIcon}"
                        FontFamily="{ThemeResource GeistSansFont}"
                        FontSize="14"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource GeistTextSecondaryBrush}" />
                </Border>

                <!-- Info column -->
                <StackPanel
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Spacing="2">
                    <!-- Title -->
                    <TextBlock
                        Text="{Binding Title}"
                        FontFamily="{ThemeResource GeistSansFont}"
                        FontSize="{ThemeResource GeistTypeSize14}"
                        FontWeight="{ThemeResource GeistTypeWeightMedium}"
                        Foreground="{ThemeResource GeistTextPrimaryBrush}"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="NoWrap"
                        MaxLines="1" />
                    <!-- Subtitle / progress text -->
                    <TextBlock
                        Text="{Binding Subtitle}"
                        FontFamily="{ThemeResource GeistSansFont}"
                        FontSize="{ThemeResource GeistTypeSize12}"
                        Foreground="{ThemeResource GeistTextSecondaryBrush}"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="NoWrap"
                        MaxLines="1" />
                </StackPanel>

                <!-- Progress bar (compact) -->
                <Border
                    Grid.Column="2"
                    Width="80"
                    Height="3"
                    CornerRadius="{ThemeResource GeistProgressTrackRadius}"
                    Background="{ThemeResource GeistGray200}"
                    VerticalAlignment="Center">
                    <Border
                        x:Name="ProgressFill"
                        Width="{Binding ProgressPercent, Converter={StaticResource PercentToWidthConverter}, ConverterParameter=80}"
                        Height="3"
                        CornerRadius="{ThemeResource GeistProgressTrackRadius}"
                        Background="{ThemeResource GeistProgressActiveBrush}"
                        HorizontalAlignment="Left" />
                </Border>

                <!-- Action button -->
                <Button
                    Grid.Column="3"
                    Content="{Binding ActionLabel}"
                    FontFamily="{ThemeResource GeistSansFont}"
                    FontSize="{ThemeResource GeistTypeSize12}"
                    Height="28"
                    MinWidth="64"
                    Padding="8,0"
                    VerticalAlignment="Center"
                    Command="{Binding ActionCommand}"
                    Style="{StaticResource SmallButtonStyle}" />
            </Grid>
        </Border>
    </DataTemplate>

    <!-- Small button style -->
    <Style x:Key="SmallButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{ThemeResource GeistGray100}" />
        <Setter Property="BorderBrush" Value="{ThemeResource GeistBorderBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource GeistTextPrimaryBrush}" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="FontFamily" Value="{ThemeResource GeistSansFont}" />
        <Setter Property="FontSize" Value="{ThemeResource GeistTypeSize12}" />
        <Setter Property="Padding" Value="8,0" />
    </Style>

</ResourceDictionary>
