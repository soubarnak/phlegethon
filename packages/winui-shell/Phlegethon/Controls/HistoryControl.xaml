<!-- HistoryControl — archive-backed completed/failed media list (#61). -->

<UserControl
    x:Class="Phlegethon.Controls.HistoryControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border
            Grid.Row="0"
            BorderBrush="{ThemeResource GeistBorderBrush}"
            BorderThickness="0,0,0,1"
            Padding="12,6"
            Background="{ThemeResource GeistSurfaceBrush}">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Grid.Column="0"
                    Text="History"
                    FontFamily="{ThemeResource GeistSansFont}"
                    FontSize="{ThemeResource GeistTypeSize13}"
                    FontWeight="{ThemeResource GeistTypeWeightSemiBold}"
                    Foreground="{ThemeResource GeistTextSecondaryBrush}"
                    VerticalAlignment="Center"
                    Margin="0,0,12,0" />
                <ComboBox
                    Grid.Column="1"
                    x:Name="HistoryFilterBox"
                    Width="160"
                    FontFamily="{ThemeResource GeistSansFont}"
                    FontSize="{ThemeResource GeistTypeSize12}"
                    SelectionChanged="OnHistoryFilterChanged"
                    SelectedIndex="0">
                    <ComboBoxItem Content="All" Tag="all" />
                    <ComboBoxItem Content="Completed" Tag="Completed" />
                    <ComboBoxItem Content="Failed" Tag="Failed" />
                </ComboBox>
            </Grid>
        </Border>

        <ListView
            Grid.Row="1"
            x:Name="HistoryList"
            Background="Transparent"
            BorderThickness="0"
            SelectionMode="None"
            ItemContainerStyle="{StaticResource GeistListViewItemStyle}">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border
                        Background="Transparent"
                        BorderBrush="{ThemeResource GeistBorderBrush}"
                        BorderThickness="0,0,0,1"
                        MinHeight="{ThemeResource GeistRowHeight}"
                        Padding="12,8">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                <TextBlock
                                    Text="{Binding Title}"
                                    FontFamily="{ThemeResource GeistSansFont}"
                                    FontSize="{ThemeResource GeistTypeSize14}"
                                    FontWeight="{ThemeResource GeistTypeWeightMedium}"
                                    Foreground="{ThemeResource GeistTextPrimaryBrush}"
                                    TextTrimming="CharacterEllipsis"
                                    MaxLines="1" />
                                <TextBlock
                                    Text="{Binding Subtitle}"
                                    FontFamily="{ThemeResource GeistSansFont}"
                                    FontSize="{ThemeResource GeistTypeSize12}"
                                    Foreground="{ThemeResource GeistTextSecondaryBrush}"
                                    TextTrimming="CharacterEllipsis"
                                    MaxLines="1" />
                            </StackPanel>

                            <StackPanel
                                Grid.Column="1"
                                Orientation="Horizontal"
                                Spacing="6"
                                VerticalAlignment="Center">
                                <Button
                                    Content="Reveal"
                                    FontFamily="{ThemeResource GeistSansFont}"
                                    FontSize="{ThemeResource GeistTypeSize12}"
                                    Height="28"
                                    MinWidth="64"
                                    Padding="8,0"
                                    Click="OnRevealClick"
                                    Tag="{Binding}"
                                    ToolTipService.ToolTip="Reveal in folder" />
                                <Button
                                    Content="Open"
                                    FontFamily="{ThemeResource GeistSansFont}"
                                    FontSize="{ThemeResource GeistTypeSize12}"
                                    Height="28"
                                    MinWidth="64"
                                    Padding="8,0"
                                    IsEnabled="{Binding CanOpen}"
                                    Click="OnOpenClick"
                                    Tag="{Binding}"
                                    ToolTipService.ToolTip="Open file" />
                                <Button
                                    Content="Re-download"
                                    FontFamily="{ThemeResource GeistSansFont}"
                                    FontSize="{ThemeResource GeistTypeSize12}"
                                    Height="28"
                                    MinWidth="88"
                                    Padding="8,0"
                                    Click="OnReDownloadClick"
                                    Tag="{Binding}" />
                                <Button
                                    Content="Remove"
                                    FontFamily="{ThemeResource GeistSansFont}"
                                    FontSize="{ThemeResource GeistTypeSize12}"
                                    Height="28"
                                    MinWidth="72"
                                    Padding="8,0"
                                    Click="OnRemoveClick"
                                    Tag="{Binding}"
                                    ToolTipService.ToolTip="Remove from History" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <TextBlock
            Grid.Row="1"
            x:Name="EmptyStateText"
            Text="No completed downloads yet."
            FontFamily="{ThemeResource GeistSansFont}"
            FontSize="{ThemeResource GeistTypeSize14}"
            Foreground="{ThemeResource GeistTextSecondaryBrush}"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Visibility="Visible" />
    </Grid>
</UserControl>
