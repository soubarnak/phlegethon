<!-- ProbeSheetControl — Dense probe-then-confirm sheet (prototype A). -->

<UserControl
    x:Class="Phlegethon.Controls.ProbeSheetControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="{ThemeResource GeistBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border
            Grid.Row="0"
            BorderBrush="{ThemeResource GeistBorderBrush}"
            BorderThickness="0,0,0,1"
            Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Probe source label -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock
                        Text="Select Format"
                        FontFamily="{ThemeResource GeistSansFont}"
                        FontSize="{ThemeResource GeistTypeSize16}"
                        FontWeight="{ThemeResource GeistTypeWeightSemiBold}"
                        Foreground="{ThemeResource GeistTextPrimaryBrush}" />
                    <TextBlock
                        x:Name="SourceLabel"
                        Text="Probing URL..."
                        FontFamily="{ThemeResource GeistSansFont}"
                        FontSize="{ThemeResource GeistTypeSize12}"
                        Foreground="{ThemeResource GeistTextSecondaryBrush}"
                        TextTrimming="CharacterEllipsis"
                        MaxLines="1" />
                </StackPanel>

                <!-- Cancel button -->
                <Button
                    Grid.Column="1"
                    x:Name="CancelButton"
                    Content="Cancel"
                    FontFamily="{ThemeResource GeistSansFont}"
                    FontSize="{ThemeResource GeistTypeSize13}"
                    Height="{ThemeResource GeistButtonHeight}"
                    Click="OnCancelClick" />
            </Grid>
        </Border>

        <!-- Media items list -->
        <ScrollViewer Grid.Row="1">
            <StackPanel>
                <StackPanel x:Name="MediaExtrasPanel" Spacing="4" Padding="12,8,12,0" />
                <StackPanel x:Name="ItemsPanel" Spacing="0" />
            </StackPanel>
        </ScrollViewer>

        <!-- Footer: Save to… + Confirm -->
        <Border
            Grid.Row="2"
            BorderBrush="{ThemeResource GeistBorderBrush}"
            BorderThickness="0,1,0,0"
            Padding="12,8"
            Background="{ThemeResource GeistSurfaceBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                    <TextBlock
                        x:Name="SelectionSummary"
                        Text="No selection"
                        FontFamily="{ThemeResource GeistSansFont}"
                        FontSize="{ThemeResource GeistTypeSize12}"
                        Foreground="{ThemeResource GeistTextSecondaryBrush}" />
                    <TextBlock
                        x:Name="SaveToPathLabel"
                        Text="Library Root default"
                        FontFamily="{ThemeResource GeistMonoFont}"
                        FontSize="{ThemeResource GeistTypeSize12}"
                        Foreground="{ThemeResource GeistTextSecondaryBrush}"
                        TextTrimming="CharacterEllipsis"
                        MaxLines="2" />
                </StackPanel>

                <Button
                    Grid.Column="1"
                    x:Name="SaveToButton"
                    Content="Save to…"
                    FontFamily="{ThemeResource GeistSansFont}"
                    FontSize="{ThemeResource GeistTypeSize13}"
                    Height="{ThemeResource GeistButtonHeight}"
                    Margin="8,0,8,0"
                    Click="OnSaveToClick" />

                <Button
                    Grid.Column="2"
                    x:Name="ConfirmButton"
                    Content="Download Selected"
                    FontFamily="{ThemeResource GeistSansFont}"
                    FontSize="{ThemeResource GeistTypeSize14}"
                    MinWidth="140"
                    Height="{ThemeResource GeistButtonHeightPrimary}"
                    IsEnabled="False"
                    Click="OnConfirmClick">
                    <Button.Resources>
                        <Color x:Key="ButtonBackgroundColor">#006BFF</Color>
                    </Button.Resources>
                </Button>
            </Grid>
        </Border>
    </Grid>
</UserControl>
