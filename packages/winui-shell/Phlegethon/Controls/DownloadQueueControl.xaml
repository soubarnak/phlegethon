<!-- DownloadQueueControl — Dense-row download queue (prototype A). -->

<UserControl
    x:Class="Phlegethon.Controls.DownloadQueueControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:automation="using:Microsoft.UI.Xaml.Automation"
    xmlns:controls="using:Phlegethon.Controls">

    <UserControl.Resources>
        <x:String x:Key="QueueActionMoveUp">Move up</x:String>
        <x:String x:Key="QueueActionMoveDown">Move down</x:String>
        <x:String x:Key="QueueActionDiscard">Discard</x:String>
        <x:String x:Key="QueueActionReveal">Reveal in folder</x:String>
        <x:String x:Key="QueueActionOpen">Open file</x:String>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Column header (batch header) -->
        <Border
            Grid.Row="0"
            BorderBrush="{ThemeResource GeistBorderBrush}"
            BorderThickness="0,0,0,1"
            Padding="12,4"
            Background="{ThemeResource GeistSurfaceBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Grid.Column="0"
                    x:Name="QueueHeaderText"
                    Text="Queue"
                    FontFamily="{ThemeResource GeistSansFont}"
                    FontSize="{ThemeResource GeistTypeSize13}"
                    FontWeight="{ThemeResource GeistTypeWeightSemiBold}"
                    Foreground="{ThemeResource GeistTextSecondaryBrush}"
                    Margin="24,0,0,0" />
            </Grid>
        </Border>

        <!-- Search / filter / sort toolbar -->
        <Border
            Grid.Row="1"
            BorderBrush="{ThemeResource GeistBorderBrush}"
            BorderThickness="0,0,0,1"
            Padding="12,6"
            Background="{ThemeResource GeistSurfaceBrush}">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox
                    Grid.Column="0"
                    x:Name="QueueSearchBox"
                    PlaceholderText="Search queue…"
                    automation:AutomationProperties.Name="Search queue"
                    FontFamily="{ThemeResource GeistSansFont}"
                    FontSize="{ThemeResource GeistTypeSize12}"
                    TextChanged="OnQueueSearchChanged" />
                <ComboBox
                    Grid.Column="1"
                    x:Name="QueueFilterBox"
                    Width="140"
                    automation:AutomationProperties.Name="Filter by state"
                    FontFamily="{ThemeResource GeistSansFont}"
                    FontSize="{ThemeResource GeistTypeSize12}"
                    SelectionChanged="OnQueueFilterChanged"
                    SelectedIndex="0">
                    <ComboBoxItem Content="All" Tag="all" />
                    <ComboBoxItem Content="Queued" Tag="queued" />
                    <ComboBoxItem Content="Downloading" Tag="downloading" />
                    <ComboBoxItem Content="Paused" Tag="paused" />
                    <ComboBoxItem Content="Completed" Tag="completed" />
                    <ComboBoxItem Content="Failed" Tag="failed" />
                </ComboBox>
                <ComboBox
                    Grid.Column="2"
                    x:Name="QueueSortBox"
                    Width="140"
                    automation:AutomationProperties.Name="Sort queue"
                    FontFamily="{ThemeResource GeistSansFont}"
                    FontSize="{ThemeResource GeistTypeSize12}"
                    SelectionChanged="OnQueueSortChanged"
                    SelectedIndex="0">
                    <ComboBoxItem Content="Queue order" Tag="queue" />
                    <ComboBoxItem Content="Title" Tag="title" />
                    <ComboBoxItem Content="Status" Tag="status" />
                    <ComboBoxItem Content="Size" Tag="size" />
                </ComboBox>
            </Grid>
        </Border>

        <!-- List of download items -->
        <ListView
            Grid.Row="2"
            x:Name="DownloadList"
            Background="Transparent"
            BorderThickness="0"
            SelectionMode="Single"
            ItemContainerStyle="{StaticResource GeistListViewItemStyle}">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="controls:DownloadItemViewModel">
                    <Border
                        Background="Transparent"
                        BorderBrush="{ThemeResource GeistBorderBrush}"
                        BorderThickness="0,0,0,1"
                        Height="{ThemeResource GeistRowHeight}"
                        Padding="12,0">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Status icon -->
                            <Border
                                Grid.Column="0"
                                Width="24"
                                Height="24"
                                CornerRadius="4"
                                Background="{ThemeResource GeistGray100}"
                                VerticalAlignment="Center"
                                automation:AutomationProperties.Name="{Binding StatusAccessibleName}">
                                <TextBlock
                                    Text="{Binding StatusIcon}"
                                    FontFamily="{ThemeResource GeistSansFont}"
                                    FontSize="14"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Foreground="{ThemeResource GeistTextSecondaryBrush}" />
                            </Border>

                            <!-- Info column -->
                            <StackPanel
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Spacing="2">
                                <TextBlock
                                    Text="{Binding Title}"
                                    FontFamily="{ThemeResource GeistSansFont}"
                                    FontSize="{ThemeResource GeistTypeSize14}"
                                    FontWeight="{ThemeResource GeistTypeWeightMedium}"
                                    Foreground="{ThemeResource GeistTextPrimaryBrush}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="NoWrap"
                                    MaxLines="1" />
                                <TextBlock
                                    Text="{Binding Subtitle}"
                                    FontFamily="{ThemeResource GeistSansFont}"
                                    FontSize="{ThemeResource GeistTypeSize12}"
                                    Foreground="{ThemeResource GeistTextSecondaryBrush}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="NoWrap"
                                    MaxLines="1" />
                            </StackPanel>

                            <!-- Progress bar -->
                            <Grid
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                Height="3">
                                <Border
                                    Height="3"
                                    CornerRadius="{ThemeResource GeistProgressTrackRadius}"
                                    Background="{ThemeResource GeistGray200}" />
                                <Border
                                    x:Name="ProgressFill"
                                    Width="{Binding ProgressPercent, Converter={StaticResource PercentToWidthConverter}}"
                                    Height="3"
                                    CornerRadius="{ThemeResource GeistProgressTrackRadius}"
                                    Background="{ThemeResource GeistProgressActiveBrush}"
                                    HorizontalAlignment="Left" />
                            </Grid>

                            <!-- Primary action + Discard -->
                            <StackPanel
                                Grid.Column="3"
                                Orientation="Horizontal"
                                Spacing="6"
                                VerticalAlignment="Center">
                                <Button
                                    Content="↑"
                                    FontFamily="{ThemeResource GeistSansFont}"
                                    FontSize="{ThemeResource GeistTypeSize12}"
                                    Height="28"
                                    Width="28"
                                    Padding="0"
                                    Click="OnMoveUpClick"
                                    automation:AutomationProperties.Name="{StaticResource QueueActionMoveUp}"
                                    ToolTipService.ToolTip="{StaticResource QueueActionMoveUp}" />
                                <Button
                                    Content="↓"
                                    FontFamily="{ThemeResource GeistSansFont}"
                                    FontSize="{ThemeResource GeistTypeSize12}"
                                    Height="28"
                                    Width="28"
                                    Padding="0"
                                    Click="OnMoveDownClick"
                                    automation:AutomationProperties.Name="{StaticResource QueueActionMoveDown}"
                                    ToolTipService.ToolTip="{StaticResource QueueActionMoveDown}" />
                                <Button
                                    Content="{Binding ActionLabel}"
                                    FontFamily="{ThemeResource GeistSansFont}"
                                    FontSize="{ThemeResource GeistTypeSize12}"
                                    Height="28"
                                    MinWidth="64"
                                    Padding="8,0"
                                    Click="OnItemAction"
                                    automation:AutomationProperties.Name="{Binding ActionLabel}"
                                    Visibility="{Binding PrimaryActionVisible}" />
                                <Button
                                    Content="{StaticResource QueueActionDiscard}"
                                    FontFamily="{ThemeResource GeistSansFont}"
                                    FontSize="{ThemeResource GeistTypeSize12}"
                                    Height="28"
                                    MinWidth="64"
                                    Padding="8,0"
                                    Click="OnDiscardClick"
                                    automation:AutomationProperties.Name="{StaticResource QueueActionDiscard}" />
                                <Button
                                    Content="{StaticResource QueueActionReveal}"
                                    FontFamily="{ThemeResource GeistSansFont}"
                                    FontSize="{ThemeResource GeistTypeSize12}"
                                    Height="28"
                                    MinWidth="64"
                                    Padding="8,0"
                                    Click="OnRevealClick"
                                    Visibility="{Binding CompletedActionsVisible}"
                                    automation:AutomationProperties.Name="{StaticResource QueueActionReveal}"
                                    ToolTipService.ToolTip="{StaticResource QueueActionReveal}" />
                                <Button
                                    Content="{StaticResource QueueActionOpen}"
                                    FontFamily="{ThemeResource GeistSansFont}"
                                    FontSize="{ThemeResource GeistTypeSize12}"
                                    Height="28"
                                    MinWidth="64"
                                    Padding="8,0"
                                    Click="OnOpenClick"
                                    Visibility="{Binding CompletedActionsVisible}"
                                    automation:AutomationProperties.Name="{StaticResource QueueActionOpen}"
                                    ToolTipService.ToolTip="{StaticResource QueueActionOpen}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Empty state -->
        <TextBlock
            Grid.Row="2"
            x:Name="EmptyStateText"
            Text="No downloads yet"
            FontFamily="{ThemeResource GeistSansFont}"
            FontSize="{ThemeResource GeistTypeSize14}"
            Foreground="{ThemeResource GeistTextSecondaryBrush}"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Visibility="Visible" />

        <!-- Footer status bar -->
        <Border
            Grid.Row="3"
            BorderBrush="{ThemeResource GeistBorderBrush}"
            BorderThickness="0,1,0,0"
            Padding="12,6"
            Background="{ThemeResource GeistSurfaceBrush}">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock
                    x:Name="StatusFooter"
                    Text="Ready"
                    FontFamily="{ThemeResource GeistSansFont}"
                    FontSize="{ThemeResource GeistTypeSize12}"
                    Foreground="{ThemeResource GeistTextSecondaryBrush}"
                    VerticalAlignment="Center" />
                <TextBlock
                    x:Name="ActiveLimitLabel"
                    Text="Active limit"
                    FontFamily="{ThemeResource GeistSansFont}"
                    FontSize="{ThemeResource GeistTypeSize12}"
                    Foreground="{ThemeResource GeistTextSecondaryBrush}"
                    VerticalAlignment="Center"
                    Margin="16,0,0,0" />
                <NumberBox
                    x:Name="ActiveJobLimitBox"
                    Minimum="1"
                    SpinButtonPlacementMode="Inline"
                    Width="72"
                    FontFamily="{ThemeResource GeistSansFont}"
                    FontSize="{ThemeResource GeistTypeSize12}" />
                <Button
                    Content="Apply"
                    FontFamily="{ThemeResource GeistSansFont}"
                    FontSize="{ThemeResource GeistTypeSize12}"
                    Height="28"
                    Padding="8,0"
                    Click="OnActiveJobLimitApply" />
                <CheckBox
                    x:Name="AudioOnlyModeBox"
                    Content="Audio only"
                    FontFamily="{ThemeResource GeistSansFont}"
                    FontSize="{ThemeResource GeistTypeSize12}"
                    VerticalAlignment="Center"
                    Margin="16,0,0,0"
                    Checked="OnAudioOnlyModeChanged"
                    Unchecked="OnAudioOnlyModeChanged" />
                <CheckBox
                    x:Name="WriteSubsDefaultBox"
                    Content="Write subs"
                    FontFamily="{ThemeResource GeistSansFont}"
                    FontSize="{ThemeResource GeistTypeSize12}"
                    VerticalAlignment="Center"
                    Margin="16,0,0,0" />
                <CheckBox
                    x:Name="WriteThumbnailDefaultBox"
                    Content="Write thumbnail"
                    FontFamily="{ThemeResource GeistSansFont}"
                    FontSize="{ThemeResource GeistTypeSize12}"
                    VerticalAlignment="Center"
                    Margin="8,0,0,0" />
                <Button
                    Content="Apply media defaults"
                    FontFamily="{ThemeResource GeistSansFont}"
                    FontSize="{ThemeResource GeistTypeSize12}"
                    Height="28"
                    Padding="8,0"
                    Margin="8,0,0,0"
                    Click="OnMediaExtrasDefaultsApply" />
                <TextBlock
                    Text="Filename template"
                    FontFamily="{ThemeResource GeistSansFont}"
                    FontSize="{ThemeResource GeistTypeSize12}"
                    Foreground="{ThemeResource GeistTextSecondaryBrush}"
                    VerticalAlignment="Center"
                    Margin="16,0,0,0" />
                <TextBox
                    x:Name="FilenameTemplateBox"
                    PlaceholderText="%(title).200B [%(id)s].%(ext)s"
                    Width="260"
                    FontFamily="{ThemeResource GeistSansFont}"
                    FontSize="{ThemeResource GeistTypeSize12}" />
                <Button
                    Content="Apply template"
                    FontFamily="{ThemeResource GeistSansFont}"
                    FontSize="{ThemeResource GeistTypeSize12}"
                    Height="28"
                    Padding="8,0"
                    Margin="8,0,0,0"
                    Click="OnFilenameTemplateApply" />
                <TextBlock
                    Text="Cookies browser"
                    FontFamily="{ThemeResource GeistSansFont}"
                    FontSize="{ThemeResource GeistTypeSize12}"
                    Foreground="{ThemeResource GeistTextSecondaryBrush}"
                    VerticalAlignment="Center"
                    Margin="16,0,0,0" />
                <TextBox
                    x:Name="CookiesFromBrowserBox"
                    PlaceholderText="chrome, firefox, edge…"
                    Width="120"
                    FontFamily="{ThemeResource GeistSansFont}"
                    FontSize="{ThemeResource GeistTypeSize12}" />
                <TextBlock
                    Text="Cookie file"
                    FontFamily="{ThemeResource GeistSansFont}"
                    FontSize="{ThemeResource GeistTypeSize12}"
                    Foreground="{ThemeResource GeistTextSecondaryBrush}"
                    VerticalAlignment="Center"
                    Margin="8,0,0,0" />
                <TextBox
                    x:Name="CookieFileBox"
                    PlaceholderText="Absolute path (optional)"
                    Width="180"
                    FontFamily="{ThemeResource GeistSansFont}"
                    FontSize="{ThemeResource GeistTypeSize12}" />
                <Button
                    Content="Apply cookies"
                    FontFamily="{ThemeResource GeistSansFont}"
                    FontSize="{ThemeResource GeistTypeSize12}"
                    Height="28"
                    Padding="8,0"
                    Margin="8,0,0,0"
                    Click="OnCookieChannelApply" />
                <TextBlock
                    Text="Proxy URL"
                    FontFamily="{ThemeResource GeistSansFont}"
                    FontSize="{ThemeResource GeistTypeSize12}"
                    Foreground="{ThemeResource GeistTextSecondaryBrush}"
                    VerticalAlignment="Center"
                    Margin="16,0,0,0" />
                <TextBox
                    x:Name="ProxyUrlBox"
                    PlaceholderText="http://host:port or socks5://host:port"
                    Width="220"
                    FontFamily="{ThemeResource GeistSansFont}"
                    FontSize="{ThemeResource GeistTypeSize12}" />
                <Button
                    Content="Apply proxy"
                    FontFamily="{ThemeResource GeistSansFont}"
                    FontSize="{ThemeResource GeistTypeSize12}"
                    Height="28"
                    Padding="8,0"
                    Margin="8,0,0,0"
                    Click="OnProxySettingsApply" />
                <CheckBox
                    x:Name="CheckSidecarUpdatesOnLaunchBox"
                    Content="Check sidecar updates on launch"
                    FontFamily="{ThemeResource GeistSansFont}"
                    FontSize="{ThemeResource GeistTypeSize12}"
                    VerticalAlignment="Center"
                    Margin="16,0,0,0"
                    Checked="OnSidecarUpdateSettingsChanged"
                    Unchecked="OnSidecarUpdateSettingsChanged" />
                <Button
                    Content="Check updates"
                    FontFamily="{ThemeResource GeistSansFont}"
                    FontSize="{ThemeResource GeistTypeSize12}"
                    Height="28"
                    Padding="8,0"
                    Margin="8,0,0,0"
                    Click="OnCheckSidecarUpdates" />
                <Button
                    Content="Apply updates"
                    FontFamily="{ThemeResource GeistSansFont}"
                    FontSize="{ThemeResource GeistTypeSize12}"
                    Height="28"
                    Padding="8,0"
                    Margin="8,0,0,0"
                    Click="OnApplySidecarUpdates" />
                <TextBox
                    x:Name="ToolchainPinBox"
                    PlaceholderText="Toolchain pin"
                    Width="100"
                    FontFamily="{ThemeResource GeistSansFont}"
                    FontSize="{ThemeResource GeistTypeSize12}" />
                <Button
                    Content="Pin toolchain"
                    FontFamily="{ThemeResource GeistSansFont}"
                    FontSize="{ThemeResource GeistTypeSize12}"
                    Height="28"
                    Padding="8,0"
                    Margin="4,0,0,0"
                    Click="OnPinToolchain" />
                <Button
                    Content="Rollback toolchain"
                    FontFamily="{ThemeResource GeistSansFont}"
                    FontSize="{ThemeResource GeistTypeSize12}"
                    Height="28"
                    Padding="8,0"
                    Margin="4,0,0,0"
                    Click="OnRollbackToolchain" />
                <TextBox
                    x:Name="PluginPinBox"
                    PlaceholderText="Plugin pin"
                    Width="90"
                    FontFamily="{ThemeResource GeistSansFont}"
                    FontSize="{ThemeResource GeistTypeSize12}"
                    Margin="8,0,0,0" />
                <Button
                    Content="Pin plugin"
                    FontFamily="{ThemeResource GeistSansFont}"
                    FontSize="{ThemeResource GeistTypeSize12}"
                    Height="28"
                    Padding="8,0"
                    Margin="4,0,0,0"
                    Click="OnPinPlugin" />
                <Button
                    Content="Rollback plugin"
                    FontFamily="{ThemeResource GeistSansFont}"
                    FontSize="{ThemeResource GeistTypeSize12}"
                    Height="28"
                    Padding="8,0"
                    Margin="4,0,0,0"
                    Click="OnRollbackPlugin" />
                <TextBlock
                    x:Name="SidecarUpdateStatusText"
                    Text=""
                    FontFamily="{ThemeResource GeistSansFont}"
                    FontSize="{ThemeResource GeistTypeSize12}"
                    Foreground="{ThemeResource GeistTextSecondaryBrush}"
                    VerticalAlignment="Center"
                    Margin="8,0,0,0" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
