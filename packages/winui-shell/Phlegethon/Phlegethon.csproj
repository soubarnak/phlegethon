<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>Phlegethon</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <PublishProfile>win-$(Platform).pubxml</PublishProfile>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <WindowsPackageType>None</WindowsPackageType>
    <RepoRoot>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\..\..\..'))</RepoRoot>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.6.241114003" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.1" />
    <PackageReference Include="Microsoft.Toolkit.Uwp.Notifications" Version="7.1.3" />
    <PackageReference Include="System.Threading.Channels" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Geist font files — embed as Content when present -->
    <Content Include="Assets\Fonts\Geist\*" Condition="Exists('Assets\Fonts\Geist')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Page Include="..\..\..\design\geist\GeistTheme.xaml" Link="Design\GeistTheme.xaml" />
    <Page Remove="Controls\DownloadQueueTemplates.xaml" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\shell-strings\en.json" Link="Strings\en.json" />
  </ItemGroup>

  <Target Name="CopyDownloadCore" AfterTargets="Build">
    <PropertyGroup>
      <DownloadCoreDll>$(RepoRoot)\target\debug\download_core.dll</DownloadCoreDll>
    </PropertyGroup>
    <Copy
      SourceFiles="$(DownloadCoreDll)"
      DestinationFolder="$(TargetDir)"
      SkipUnchangedFiles="true"
      Condition="Exists('$(DownloadCoreDll)')" />
  </Target>

</Project>
