<!-- MainWindow — Phlegethon Shell -->

<Window
    x:Class="Phlegethon.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Phlegethon.Controls"
    Title="Phlegethon"
    MinWidth="480"
    MinHeight="400">

    <Grid Background="{ThemeResource GeistBackgroundBrush}">
        <Grid.RowDefinitions>
            <!-- Top bar -->
            <RowDefinition Height="Auto" />
            <!-- Main content: queue or probe sheet -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top Bar -->
        <Border
            Grid.Row="0"
            BorderBrush="{ThemeResource GeistBorderBrush}"
            BorderThickness="0,0,0,1"
            Padding="{ThemeResource GeistSpace5}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- App title -->
                <TextBlock
                    Grid.Column="0"
                    Text="Phlegethon"
                    FontFamily="{ThemeResource GeistSansFont}"
                    FontSize="{ThemeResource GeistTypeSize16}"
                    FontWeight="{ThemeResource GeistTypeWeightSemiBold}"
                    VerticalAlignment="Center"
                    Margin="0,0,16,0" />

                <!-- URL input area: paste hint + status -->
                <TextBlock
                    Grid.Column="1"
                    x:Name="UrlStatusText"
                    Text="Paste a URL or drop a file/link to start"
                    FontFamily="{ThemeResource GeistSansFont}"
                    FontSize="{ThemeResource GeistTypeSize13}"
                    Foreground="{ThemeResource GeistTextSecondaryBrush}"
                    VerticalAlignment="Center"
                    TextWrapping="NoWrap"
                    TextTrimming="CharacterEllipsis" />

                <!-- Add URL button -->
                <Button
                    Grid.Column="2"
                    x:Name="AddUrlButton"
                    Content="Add URL"
                    FontFamily="{ThemeResource GeistSansFont}"
                    FontSize="{ThemeResource GeistTypeSize14}"
                    Height="{ThemeResource GeistButtonHeight}"
                    Click="OnAddUrlClick">
                    <Button.Resources>
                        <SolidColorBrush x:Key="ButtonBackground" Color="{ThemeResource GeistGray1000}" />
                        <SolidColorBrush x:Key="ButtonForeground" Color="{ThemeResource GeistBackground100}" />
                    </Button.Resources>
                </Button>
            </Grid>
        </Border>

        <!-- Content area -->
        <Grid
            Grid.Row="1"
            x:Name="ContentArea"
            Margin="0">

            <!-- Download Queue (default view) -->
            <controls:DownloadQueueControl
                x:Name="DownloadQueueView"
                Visibility="Visible" />

            <!-- Probe-then-Confirm Sheet (shown when probing) -->
            <controls:ProbeSheetControl
                x:Name="ProbeSheetView"
                Visibility="Collapsed" />
        </Grid>
    </Grid>
</Window>
