<!-- MainWindow — Phlegethon Shell -->

<Window
    x:Class="Phlegethon.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Phlegethon.Controls"
    Title="Phlegethon">

    <Grid Background="{ThemeResource GeistBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border
            Grid.Row="0"
            BorderBrush="{ThemeResource GeistBorderBrush}"
            BorderThickness="0,0,0,1"
            Padding="{ThemeResource GeistSpace5}">
            <StackPanel Spacing="8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        Grid.Column="0"
                        Text="Phlegethon"
                        FontFamily="{ThemeResource GeistSansFont}"
                        FontSize="{ThemeResource GeistTypeSize16}"
                        FontWeight="{ThemeResource GeistTypeWeightSemiBold}"
                        VerticalAlignment="Center"
                        Margin="0,0,16,0" />

                    <TextBox
                        Grid.Column="1"
                        x:Name="UrlInput"
                        PlaceholderText="Paste or type URL(s), then press Enter or Enqueue"
                        FontFamily="{ThemeResource GeistMonoFont}"
                        FontSize="{ThemeResource GeistTypeSize13}"
                        AcceptsReturn="True"
                        TextWrapping="Wrap"
                        MaxHeight="96"
                        KeyDown="OnUrlInputKeyDown" />

                    <Button
                        Grid.Column="2"
                        x:Name="EnqueueButton"
                        Content="Enqueue"
                        FontFamily="{ThemeResource GeistSansFont}"
                        FontSize="{ThemeResource GeistTypeSize14}"
                        Height="{ThemeResource GeistButtonHeight}"
                        Margin="8,0,0,0"
                        Click="OnEnqueueClick" />

                    <Button
                        Grid.Column="3"
                        x:Name="AddUrlButton"
                        Content="Add URL"
                        FontFamily="{ThemeResource GeistSansFont}"
                        FontSize="{ThemeResource GeistTypeSize14}"
                        Height="{ThemeResource GeistButtonHeight}"
                        Margin="8,0,0,0"
                        Click="OnAddUrlClick" />
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        Grid.Column="0"
                        x:Name="UrlStatusText"
                        Text="Paste multiple URLs to enqueue or probe them"
                        FontFamily="{ThemeResource GeistSansFont}"
                        FontSize="{ThemeResource GeistTypeSize12}"
                        Foreground="{ThemeResource GeistTextSecondaryBrush}"
                        TextTrimming="CharacterEllipsis" />

                    <StackPanel
                        Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="16">
                        <CheckBox
                            x:Name="ClipboardWatcherBox"
                            Content="Watch clipboard"
                            FontFamily="{ThemeResource GeistSansFont}"
                            FontSize="{ThemeResource GeistTypeSize12}"
                            Checked="OnClipboardWatcherChanged"
                            Unchecked="OnClipboardWatcherChanged" />

                        <CheckBox
                            x:Name="DesktopNotificationsBox"
                            Content="Desktop notifications"
                            FontFamily="{ThemeResource GeistSansFont}"
                            FontSize="{ThemeResource GeistTypeSize12}"
                            Checked="OnDesktopNotificationsChanged"
                            Unchecked="OnDesktopNotificationsChanged" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <Grid
            Grid.Row="1"
            x:Name="ContentArea"
            Margin="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border
                Grid.Row="0"
                BorderBrush="{ThemeResource GeistBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="12,4"
                Background="{ThemeResource GeistSurfaceBrush}">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <Button
                        x:Name="QueueTabButton"
                        Content="Queue"
                        FontFamily="{ThemeResource GeistSansFont}"
                        FontSize="{ThemeResource GeistTypeSize13}"
                        Height="32"
                        Padding="12,0"
                        Click="OnQueueTabClick" />
                    <Button
                        x:Name="HistoryTabButton"
                        Content="History"
                        FontFamily="{ThemeResource GeistSansFont}"
                        FontSize="{ThemeResource GeistTypeSize13}"
                        Height="32"
                        Padding="12,0"
                        Click="OnHistoryTabClick" />
                </StackPanel>
            </Border>

            <Grid Grid.Row="1">
                <controls:DownloadQueueControl
                    x:Name="DownloadQueueView"
                    Visibility="Visible" />

                <controls:HistoryControl
                    x:Name="HistoryView"
                    Visibility="Collapsed" />

                <controls:ProbeSheetControl
                    x:Name="ProbeSheetView"
                    Visibility="Collapsed" />
            </Grid>
        </Grid>
    </Grid>
</Window>
