<!-- MainWindow — Phlegethon Shell -->

<Window
    x:Class="Phlegethon.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Phlegethon.Controls"
    Title="Phlegethon"
    MinWidth="480"
    MinHeight="400">

    <Grid Background="{ThemeResource GeistBackgroundBrush}">
        <Grid.RowDefinitions>
            <!-- Top bar -->
            <RowDefinition Height="Auto" />
            <!-- Main content: queue or probe sheet -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top Bar -->
        <Border
            Grid.Row="0"
            BorderBrush="{ThemeResource GeistBorderBrush}"
            BorderThickness="0,0,0,1"
            Padding="{ThemeResource GeistSpace5}">
            <StackPanel Spacing="8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        Grid.Column="0"
                        Text="Phlegethon"
                        FontFamily="{ThemeResource GeistSansFont}"
                        FontSize="{ThemeResource GeistTypeSize16}"
                        FontWeight="{ThemeResource GeistTypeWeightSemiBold}"
                        VerticalAlignment="Center"
                        Margin="0,0,16,0" />

                    <TextBox
                        Grid.Column="1"
                        x:Name="UrlInput"
                        PlaceholderText="Paste or type URL(s)… then press Enter or Enqueue"
                        FontFamily="{ThemeResource GeistMonoFont}"
                        FontSize="{ThemeResource GeistTypeSize13}"
                        AcceptsReturn="True"
                        TextWrapping="Wrap"
                        MaxHeight="96"
                        KeyDown="OnUrlInputKeyDown" />

                    <Button
                        Grid.Column="2"
                        x:Name="EnqueueButton"
                        Content="Enqueue"
                        FontFamily="{ThemeResource GeistSansFont}"
                        FontSize="{ThemeResource GeistTypeSize14}"
                        Height="{ThemeResource GeistButtonHeight}"
                        Margin="8,0,0,0"
                        Click="OnEnqueueClick">
                        <Button.Resources>
                            <SolidColorBrush x:Key="ButtonBackground" Color="{ThemeResource GeistGray1000}" />
                            <SolidColorBrush x:Key="ButtonForeground" Color="{ThemeResource GeistBackground100}" />
                        </Button.Resources>
                    </Button>

                    <Button
                        Grid.Column="3"
                        x:Name="AddUrlButton"
                        Content="Add URL"
                        FontFamily="{ThemeResource GeistSansFont}"
                        FontSize="{ThemeResource GeistTypeSize14}"
                        Height="{ThemeResource GeistButtonHeight}"
                        Margin="8,0,0,0"
                        Click="OnAddUrlClick" />
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        Grid.Column="0"
                        x:Name="UrlStatusText"
                        Text="Paste multiple URLs to enqueue or probe them"
                        FontFamily="{ThemeResource GeistSansFont}"
                        FontSize="{ThemeResource GeistTypeSize12}"
                        Foreground="{ThemeResource GeistTextSecondaryBrush}"
                        TextTrimming="CharacterEllipsis" />

                    <CheckBox
                        Grid.Column="1"
                        x:Name="ClipboardWatcherBox"
                        Content="Watch clipboard"
                        FontFamily="{ThemeResource GeistSansFont}"
                        FontSize="{ThemeResource GeistTypeSize12}"
                        Checked="OnClipboardWatcherChanged"
                        Unchecked="OnClipboardWatcherChanged" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- Content area -->
        <Grid
            Grid.Row="1"
            x:Name="ContentArea"
            Margin="0">

            <!-- Download Queue (default view) -->
            <controls:DownloadQueueControl
                x:Name="DownloadQueueView"
                Visibility="Visible" />

            <!-- Probe-then-Confirm Sheet (shown when probing) -->
            <controls:ProbeSheetControl
                x:Name="ProbeSheetView"
                Visibility="Collapsed" />
        </Grid>
    </Grid>
</Window>
