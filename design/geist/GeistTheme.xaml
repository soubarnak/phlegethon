            <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="{ThemeResource GeistGray100}" />
            <SolidColorBrush x:Key="ListViewItemBackgroundPressed" Color="{ThemeResource GeistGray200}" />

