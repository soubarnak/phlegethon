            <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillPointerOver" Color="{ThemeResource GeistGray800}" />
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillPressed" Color="{ThemeResource GeistGray1000}" />

