            <SolidColorBrush x:Key="ProgressBarBorderBrush" Transparent="True" />
            <SolidColorBrush x:Key="ProgressBarIndicatorForeground" Color="{ThemeResource GeistBlue700}" />
            <x:Double x:Key="ProgressBarThemeHeight">3</x:Double>
            <x:Double x:Key="ProgressBarContainerThemeHeight">3</x:Double>

            <!-- Button lightweight styling -->
            <SolidColorBrush x:Key="ButtonBackground" Color="{ThemeResource GeistGray100}" />
            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="{ThemeResource GeistGray200}" />
            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="{ThemeResource GeistGray300}" />
            <SolidColorBrush x:Key="ButtonBorderBrush" Color="{ThemeResource GeistGray400}" />
            <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="{ThemeResource GeistGray500}" />
            <SolidColorBrush x:Key="ButtonForeground" Color="{ThemeResource GeistGray1000}" />
            <CornerRadius x:Key="ButtonCornerRadius">6</CornerRadius>

            <!-- CheckBox -->
