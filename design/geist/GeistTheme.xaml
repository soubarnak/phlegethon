    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Geist token SoT for Phlegethon.
         Light / Dark / HighContrast theme dictionaries.
         Values from vendored design.md / design.dark.md (sRGB hex).
         HighContrast defers to system brushes. -->

    <ResourceDictionary.ThemeDictionaries>

