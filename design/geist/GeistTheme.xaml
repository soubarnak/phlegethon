            <Color x:Key="GeistGray400">#EAEAEA</Color>
            <Color x:Key="GeistGray500">#C0C0C0</Color>
            <Color x:Key="GeistGray600">#7A7A7A</Color>
            <Color x:Key="GeistGray700">#5C5C5C</Color>
            <Color x:Key="GeistGray800">#4D4D4D</Color>
            <Color x:Key="GeistGray900">#4D4D4D</Color>
            <Color x:Key="GeistGray1000">#171717</Color>
            <Color x:Key="GeistBlue700">#006BFF</Color>
            <Color x:Key="GeistGreen700">#28A948</Color>
            <Color x:Key="GeistRed700">#FC0035</Color>
            <Color x:Key="GeistAmber700">#FFAE00</Color>

