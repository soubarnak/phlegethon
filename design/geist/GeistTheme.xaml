            <SolidColorBrush x:Key="GeistTextPrimaryBrush" Color="{ThemeResource GeistGray1000}" />
            <SolidColorBrush x:Key="GeistTextSecondaryBrush" Color="{ThemeResource GeistGray900}" />
            <SolidColorBrush x:Key="GeistTextDisabledBrush" Color="{ThemeResource GeistGray500}" />
            <SolidColorBrush x:Key="GeistAccentBrush" Color="{ThemeResource GeistBlue700}" />
            <SolidColorBrush x:Key="GeistAccentHoverBrush" Color="{ThemeResource GeistBlue700}" Opacity="0.85" />
            <SolidColorBrush x:Key="GeistSuccessBrush" Color="{ThemeResource GeistGreen700}" />
            <SolidColorBrush x:Key="GeistDangerBrush" Color="{ThemeResource GeistRed700}" />
            <SolidColorBrush x:Key="GeistWarningBrush" Color="{ThemeResource GeistAmber700}" />
            <SolidColorBrush x:Key="GeistProgressActiveBrush" Color="{ThemeResource GeistBlue700}" />
            <SolidColorBrush x:Key="GeistProgressDoneBrush" Color="{ThemeResource GeistGreen700}" />
            <SolidColorBrush x:Key="GeistProgressFailedBrush" Color="{ThemeResource GeistGray400}" />
            <SolidColorBrush x:Key="GeistProgressPausedBrush" Color="{ThemeResource GeistAmber700}" />
            <SolidColorBrush x:Key="GeistRowHoverBrush" Color="{ThemeResource GeistGray100}" />

            <!-- Typography -->
            <x:Double x:Key="GeistTypeSize20">20</x:Double>
            <x:Double x:Key="GeistTypeSize16">16</x:Double>
            <x:Double x:Key="GeistTypeSize14">14</x:Double>
            <x:Double x:Key="GeistTypeSize13">13</x:Double>
            <x:Double x:Key="GeistTypeSize12">12</x:Double>
            <FontFamily x:Key="GeistSansFont">/Assets/Fonts/Geist/Geist-Variable.ttf#Geist Sans</FontFamily>
            <FontFamily x:Key="GeistMonoFont">/Assets/Fonts/Geist/GeistMono-Variable.ttf#Geist Mono</FontFamily>
            <FontFamily x:Key="GeistFallbackFont">Segoe UI Variable, Segoe UI, Arial, sans-serif</FontFamily>
            <x:Double x:Key="GeistTypeWeightRegular">400</x:Double>
            <x:Double x:Key="GeistTypeWeightMedium">500</x:Double>
            <x:Double x:Key="GeistTypeWeightSemiBold">600</x:Double>

            <!-- Spacing (base = 4px) -->
            <Thickness x:Key="GeistSpace1">1,1,1,1</Thickness>
            <Thickness x:Key="GeistSpace2">4,4,4,4</Thickness>
            <Thickness x:Key="GeistSpace3">8,8,8,8</Thickness>
            <Thickness x:Key="GeistSpace4">12,12,12,12</Thickness>
            <Thickness x:Key="GeistSpace5">16,16,16,16</Thickness>
            <Thickness x:Key="GeistSpace6">24,24,24,24</Thickness>
            <Thickness x:Key="GeistSpace8">32,32,32,32</Thickness>
            <x:Double x:Key="GeistRowPaddingX">12</x:Double>
            <x:Double x:Key="GeistRowPaddingY">8</x:Double>
            <x:Double x:Key="GeistBatchIndent">24</x:Double>

            <!-- Radii -->
            <CornerRadius x:Key="GeistRadiusSm">6</CornerRadius>
            <CornerRadius x:Key="GeistRadiusMd">12</CornerRadius>
            <CornerRadius x:Key="GeistRadiusLg">16</CornerRadius>

            <!-- Control heights -->
            <x:Double x:Key="GeistButtonHeight">32</x:Double>
